{
  "name": "minigames-publish-console",
  "version": "0.1.9",
  "private": true,
  "description": "Multi-channel mini-game publish console: build registration, release orchestration and H5 traffic switching",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "clean": "node -e \"for (const d of ['dist','dist-test']) fs.rmSync(d,{recursive:true,force:true})\"",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "better-sqlite3": "^13.2.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/yauzl": "^3.4.0",
    "typescript": "^5.7.2"
  }
}
